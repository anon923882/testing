    Hub.log("run_payload_built", payload)
    if Hub.Config.SendRunWebhook then
        Hub.Network.sendUserWebhook(payload)
    end
end

function Hub.onUltimateDrop(item)
    local payload = Hub.Payloads.ultimateDrop(item)
    Hub.log("ultimate_payload_built", payload)
    if Hub.Config.SendDropWebhook then
        Hub.Network.sendUserWebhook(payload)
    end
    Hub.Network.sendGlobalUltimateWebhook(payload)
end

