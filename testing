local function typeofSafe(v)
    if typeof then
        local ok, t = pcall(typeof, v)
        if ok then return t end
    end
    return type(v)
end

local function esc(s)
    s = tostring(s)
    return s:gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t")
end

local function fallbackJson(v, depth, seen)
    depth = depth or 0
    seen = seen or {}
    if depth > 6 then return "\"<max_depth>\"" end
    local t = typeofSafe(v)
    if t == "nil" then return "null" end
    if t == "boolean" or t == "number" then return tostring(v) end
    if t == "string" then return "\"" .. esc(v) .. "\"" end
    if t == "table" then
        if seen[v] then return "\"<cycle>\"" end
        seen[v] = true
        local isArray, maxIndex = true, 0
        for k in pairs(v) do
            if type(k) ~= "number" then isArray = false break end
            if k > maxIndex then maxIndex = k end
        end
        local parts = {}
        if isArray then
            for i = 1, maxIndex do
                table.insert(parts, fallbackJson(v[i], depth + 1, seen))
            end
            return "[" .. table.concat(parts, ",") .. "]"
        end
        for k, val in pairs(v) do
            table.insert(parts, fallbackJson(tostring(k), depth + 1, seen) .. ":" .. fallbackJson(val, depth + 1, seen))
        end
        return "{" .. table.concat(parts, ",") .. "}"
    end
    return "\"" .. esc("<" .. tostring(t) .. ":" .. tostring(v) .. ">") .. "\""
end

local function encodeJson(v)
    local ok, http = pcall(function()
        return game:GetService("HttpService")
    end)
    if ok and http and http.JSONEncode then
        local ok2, encoded = pcall(function()
            return http:JSONEncode(v)
        end)
        if ok2 then return encoded end
    end
    return fallbackJson(v)
end

local function appendLine(path, line)
    if appendfile then
        local ok = pcall(function() appendfile(path, line .. "\n") end)
        if ok then return true end
    end
    if writefile and readfile and isfile then
        local ok = pcall(function()
            local old = ""
            if isfile(path) then old = readfile(path) end
            writefile(path, old .. line .. "\n")
        end)
        if ok then return true end
    end
    return false
end

function Hub.log(kind, data)
    local event = {
        version = Hub.Version,
        time = os and os.time and os.time() or 0,
        kind = tostring(kind),
        data = data or {},
    }
    table.insert(Hub.Runtime.Log, event)
    appendLine(LogFile, encodeJson(event))
    print("[DQ Clean v17]", kind)
    if Hub.Runtime.StatusText then
        Hub.Runtime.StatusText.Text = "Last event: " .. tostring(kind) .. "\nLog file: " .. LogFile .. "\nEvents: " .. tostring(#Hub.Runtime.Log)
    end
    return event
end

local function blocked(name, reason, data)
    return Hub.log("blocked", { name = tostring(name), reason = tostring(reason), data = data or {} })
end

function Hub.resetLog()
    if writefile then pcall(function() writefile(LogFile, "") end) end
    Hub.Runtime.Log = {}
end

function Hub.assertSecurity()
    local expected = {
        AllowOriginalVM = false,
        AllowKeySystem = false,
        AllowExternalHttp = false,
        AllowDiscordWebhook = false,
        AllowDashboardTelemetry = false,
        AllowQueueOnTeleport = false,
        AllowExternalUILoad = false,
        AllowGameRemotes = false,
        DryRun = true,
    }
    for key, value in pairs(expected) do
        if Hub.SecurityPolicy[key] == value then
            Hub.log("security_pass", { key = key, value = value })
        else
            Hub.log("security_fail", { key = key, expected = value, actual = Hub.SecurityPolicy[key] })
        end
    end
end

