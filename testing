function Hub.selfTest()
    Hub.resetLog()
    Hub.assertSecurity()

    Hub.Network.httpGet("external-ui-removed")
    Hub.Network.request({ label = "external-http-removed" })
    Hub.Network.queueOnTeleport("removed")
    Hub.updateDashboardStats()

    Hub.Config.SendRunWebhook = true
    Hub.Config.SendDropWebhook = true
    Hub.onRunFinished({ success = true, player = "DRY_RUN", dungeon = "DRY_RUN", level = 0, gold = 0, exp = 0, time = "00:00", drops = "none" })
    Hub.onUltimateDrop({ Name = "DRY_RUN_ULTIMATE" })

    Hub.Config.AutoFarm = true
    Hub.Config.AutoJoin = true
    Hub.Config.AutoBonusBoss = true
    Hub.Config.Killaura = true
    Hub.Config.AutoSell = true
    Hub.Config.SelectedDungeon = "DRY_RUN_DUNGEON"
    Hub.Config.SelectedDifficulty = "DRY_RUN_DIFFICULTY"

    Hub.Loops.autoFarmTick()
    Hub.Dungeon.retry()
    Hub.Party.create()
    Hub.Party.handleJoinRequest("DRY_RUN_PLAYER", true)
    Hub.Party.kick("DRY_RUN_PLAYER")
    Hub.Combat.castSkill("DRY_RUN_SLOT", "DRY_RUN_ENEMY")

    Hub.ConfigSystem.save("dryrun")
    Hub.ConfigSystem.load("dryrun")

    Hub.UI.createLocal()

    Hub.log("self_test_complete", { outputFile = LogFile })
    print("[DQ Clean v16] Done. Upload " .. LogFile)
end

Hub.selfTest()

return Hub
