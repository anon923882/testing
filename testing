function Hub.ConfigSystem.sanitized()
    local copy = {}
    for k,v in pairs(Hub.Config) do if k=="UserWebhookUrl" then copy[k]="" else copy[k]=v end end
    return copy
end
function Hub.ConfigSystem.save(name)
    name = tostring(name or Hub.Config.ConfigName or "default")
    if not writefile then return blocked("writefile","writefile unavailable",{name=name}) end
    Hub.ConfigSystem.ensureFolder()
    local path = Hub.Config.ConfigFolder .. name .. ".json"
    writefile(path, encode(Hub.ConfigSystem.sanitized()))
    return Hub.log("config_saved", {path=path, webhookPersisted=false})
end
function Hub.ConfigSystem.load(name)
    name = tostring(name or Hub.Config.ConfigName or "default")
    local path = Hub.Config.ConfigFolder .. name .. ".json"
    if not readfile or not isfile or not isfile(path) then return blocked("readfile","config missing",{path=path}) end
    local raw = readfile(path)
    return Hub.log("config_loaded_raw", {path=path, bytes=#raw})
end

