--[[
  Recovered and simplified script based on repo salvage.
  Notes:
  - Keeps safe pieces: game load wait, teleport queue, folder/config bootstrap, version warning.
  - Removes decompiler artifacts and broken VM register code.
]]

local SCRIPT_NAME = "Nihility Hub - Dungeon Quest"
local SCRIPT_VERSION = "1.2.0"
local GUI_URL = "https://raw.githubusercontent.com/ValorantIsKewl/RBX/refs/heads/main/GUI.lua"
local TELEPORT_LOADER = "loadstring(game:HttpGet('https://raw.githubusercontent.com/ValorantIsKewl/Nihility-Hub/refs/heads/main/Loader.lua'))()"

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

local function waitForGameLoaded()
  while not game:IsLoaded() do
    task.wait()
  end
end

local function safeQueueOnTeleport(code)
  local qot = rawget(getfenv(), "queue_on_teleport")
  if type(qot) == "function" then
    qot(code)
  end
end

local function ensureDir(path)
  if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(path) then
    makefolder(path)
  end
end

local function ensureFile(path, contents)
  if type(isfile) == "function" and type(writefile) == "function" and not isfile(path) then
    writefile(path, contents)
  end
end

local function readConfig(path)
  if type(isfile) ~= "function" or type(readfile) ~= "function" then
    return nil
  end

  if not isfile(path) then
    return nil
  end

  local ok, raw = pcall(readfile, path)
  if not ok then
    warn(string.format("%s: failed reading config at %s", SCRIPT_NAME, path))
    return nil
  end

  local decodeOk, data = pcall(HttpService.JSONDecode, HttpService, raw)
  if decodeOk and type(data) == "table" then
    return data
  end

  warn(string.format("%s: invalid config JSON at %s, using defaults", SCRIPT_NAME, path))
  return nil
end

local function writeConfig(path, data)
  if type(writefile) ~= "function" then
    return
  end
  local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
  if ok then
    writefile(path, encoded)
  end
end

local function loadGui(url)
  local okHttp, src = pcall(function()
    return game:HttpGet(url)
  end)
  if not okHttp then
    error(string.format("%s: HttpGet failed for GUI (%s)", SCRIPT_NAME, tostring(src)))
  end

  local okLoad, chunk = pcall(loadstring, src)
  if not okLoad or type(chunk) ~= "function" then
    error(string.format("%s: loadstring failed for GUI chunk", SCRIPT_NAME))
  end

  local okRun, guiFactory, remoteVersion = pcall(chunk)
  if not okRun then
    error(string.format("%s: GUI chunk runtime error: %s", SCRIPT_NAME, tostring(guiFactory)))
  end

  if remoteVersion and remoteVersion ~= "1.0.0" then
    warn(string.format("%s: Outdated/changed GUI version reported (%s)", SCRIPT_NAME, tostring(remoteVersion)))
  end

  return guiFactory, remoteVersion
end

local function defaultConfig()
  return {
    Name = "Default",
    Version = SCRIPT_VERSION,
    Settings = {
      AutoFarm = false,
      Killaura = false,
      AutoSell = false,
      AutoRetry = false,
      SkipCutscene = false,
      AutoBonusBoss = false,
      AutoJoin = false,
      AutoCarry = false,
    }
  }
end

waitForGameLoaded()
safeQueueOnTeleport(TELEPORT_LOADER)

local root = "Nihility Hub"
local gameRoot = root .. "/Dungeon Quest"
local userRoot = string.format("%s/%s", gameRoot, tostring(LocalPlayer.UserId))
local configPath = userRoot .. "/Config.json"

ensureDir(root)
ensureDir(gameRoot)
ensureDir(userRoot)

local config = readConfig(configPath)
if not config then
  config = defaultConfig()
  writeConfig(configPath, config)
else
  config.Version = config.Version or SCRIPT_VERSION
  config.Name = config.Name or "Default"
  config.Settings = config.Settings or defaultConfig().Settings
end

print(SCRIPT_NAME)
local guiFactory = nil
local guiVersion = nil

local ok, resultFactory, resultVersion = pcall(loadGui, GUI_URL)
if ok then
  guiFactory = resultFactory
  guiVersion = resultVersion
else
  warn(resultFactory)
end

if type(guiFactory) == "function" then
  local okGui, guiError = pcall(guiFactory)
  if not okGui then
    warn(string.format("%s: failed to initialize GUI factory: %s", SCRIPT_NAME, tostring(guiError)))
  end
end

return {
  Name = SCRIPT_NAME,
  Version = SCRIPT_VERSION,
  GuiVersion = guiVersion,
  Config = config,
}
