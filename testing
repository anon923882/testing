    Hub.log("remote_stub", {
        name = tostring(name),
        argc = #args,
        args = args,
        evidence = Hub.StaticEvidence.RecoveredActionSymbols[tostring(name)] or nil,
        fired = false,
        reason = "Game remotes disabled; exact original tuple not yet proven",
    })
    if Hub.SecurityPolicy.AllowGameRemotes then
        error("Live remote firing intentionally not implemented: " .. tostring(name))
    end
    return nil
end

