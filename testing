local function findAnswers(question)
	local nq = normalize(question)
	-- Exact match
	for q, a in pairs(answers) do
		if nq == normalize(q) then
			return a
		end
	end
	-- Fuzzy match
	local bestList, bestScore = nil, 0
	for q, a in pairs(answers) do
		local score = 0
		for word in nq:gmatch("%S+") do
			if #word > 2 and normalize(q):find(word, 1, true) then
				score += 1
			end
		end
		if score > bestScore then
			bestScore = score
			bestList = a
		end
	end
	if bestScore >= 2 then return bestList end
	return nil
end

-- Track which answer worked
local PendingQuestion = nil
local PendingQuestion = nil
local PendingAnswerIndex = nil
local PendingAnswerList = nil

CoinEvent.OnClientEvent:Connect(function()
	if PendingQuestion and PendingAnswerIndex then
		local answer = PendingAnswerList[PendingAnswerIndex]
		local q = PendingQuestion
		table.insert(Log.correct, {q = q, a = answer})
		print("[LOG] ✓ CORRECT: '" .. answer .. "' for: " .. q)
		SendWebhook("✅ **CORRECT** | `" .. answer .. "` (" .. #answer .. " chars)\n**Q:** " .. q)
		PendingQuestion = nil
		PendingAnswerIndex = nil
		PendingAnswerList = nil
		Answering = false
	end
end)

QuestionEvent.OnClientEvent:Connect(function(question)
	if type(question) ~= "string" or question == "Close" or #question < 3 then return end
	if Answering then return end
	Answering = true

	task.spawn(function()
		task.wait(0.5)
		local q = QuestionLabel.Text

		if not Log.seen[q] then
			Log.seen[q] = true
			print("[LOG] NEW QUESTION: " .. q)
			SendWebhook("🔵 **NEW QUESTION SEEN**\n**Q:** " .. q)
		end

		local list = findAnswers(q)
		if not list then
			print("[LOG] ? UNKNOWN: " .. q)
			table.insert(Log.unknown, q)
			SendWebhook("❓ **NO DICTIONARY MATCH**\n**Q:** " .. q)
			Answering = false
			return
		end

		local tried = {}
		for i, answer in ipairs(list) do
			if not Answering then break end
			PendingQuestion = q
			PendingAnswerIndex = i
			PendingAnswerList = list
			table.insert(tried, answer)

			print("[LOG] Trying (" .. i .. "/" .. #list .. "): '" .. answer .. "'")
			AnswerFunction:InvokeServer(answer, q)
			task.wait(0.8)

			if not PendingQuestion then break end

			table.insert(Log.failed, {q = q, a = answer})
			print("[LOG] ✗ Failed: '" .. answer .. "'")
		end

		if PendingQuestion then
			print("[LOG] ✗ ALL FAILED for: " .. q)
			SendWebhook("❌ **ALL ANSWERS FAILED**\n**Q:** " .. q .. "\n**Tried:** `" .. table.concat(tried, ", ") .. "`")
			PendingQuestion = nil
			PendingAnswerIndex = nil
			PendingAnswerList = nil
		end

		task.wait(1)
		Answering = false
	end)
end)

_G.PrintAnswerLog = function()
	print("\n===== ANSWER LOG =====")
	print("CORRECT:")
	for _, v in ipairs(Log.correct) do print("  ✓ [" .. v.q .. "] = " .. v.a) end
	print("FAILED:")
	for _, v in ipairs(Log.failed) do print("  ✗ [" .. v.q .. "] = " .. v.a) end
	print("UNKNOWN:")
	for _, v in ipairs(Log.unknown) do print("  ? " .. v) end
	print("======================\n")
end

_G.DumpLogToWebhook = function()
	local lines = {"📊 **FULL SESSION LOG**\n"}
	table.insert(lines, "**✅ Correct:**")
	for _, v in ipairs(Log.correct) do
		table.insert(lines, "`" .. v.a .. "` → " .. v.q)
	end
	table.insert(lines, "\n**❌ All Failed:**")
	for _, v in ipairs(Log.unknown) do
		table.insert(lines, "? " .. v)
	end
	-- Split into chunks of 1900 chars (Discord limit is 2000)
	local chunk = ""
	for _, line in ipairs(lines) do
		if #chunk + #line > 1900 then
			SendWebhook(chunk)
			chunk = ""
			task.wait(1)
		end
		chunk = chunk .. line .. "\n"
	end
	if #chunk > 0 then SendWebhook(chunk) end
	print("[LOG] Full log sent to webhook.")
end

print("[AutoAnswer] Loaded. Webhook logging active. Run _G.DumpLogToWebhook() for full session dump.")
