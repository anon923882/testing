--// Auto detect loop
task.spawn(function()
    task.wait(0.5)

    DetectAndRender()

    while ScreenGui and ScreenGui.Parent do
        task.wait(1.0)

        if AutoDetect then
            local Question = DetectQuestionFromScreen()
            if Question and Question ~= "" and Normalize(Question) ~= Normalize(LastDetectedQuestion) then
                RenderAnswers(Question)
            end
        end
    end
end)

