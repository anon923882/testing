--// Utility
local function Normalize(Text)
    Text = tostring(Text or ""):lower()
    Text = Text:gsub("&", " and ")
    Text = Text:gsub("[%p%c]", " ")
    Text = Text:gsub("%s+", " ")
    Text = Text:gsub("^%s+", "")
    Text = Text:gsub("%s+$", "")
    return Text
end

local function Compact(Text)
    return (Normalize(Text):gsub("%s+", ""))
end

local function ScoreQuestion(Query, Key)
    local Q = Normalize(Query)
    local K = Normalize(Key)

    if Q == "" or K == "" then
        return 0
    end

    if Q == K then
        return 1000
    end

    if Q:find(K, 1, true) then
        return 800 + #K
    end

    if K:find(Q, 1, true) then
        return 700 + #Q
    end

    local CQ = Compact(Q)
    local CK = Compact(K)

    if CQ == CK then
        return 950
    end

    if CQ:find(CK, 1, true) then
        return 750 + #CK
    end

    if CK:find(CQ, 1, true) then
        return 650 + #CQ
    end

    local Score = 0
    for Word in Q:gmatch("%S+") do
        if #Word >= 3 and K:find(Word, 1, true) then
            Score = Score + #Word
        end
    end

    return Score
end

local function FindAnswers(Query)
    local Ranked = {}

    for _, Entry in ipairs(RawQuestions) do
        local Score = ScoreQuestion(Query, Entry.Key)
        if Score > 0 then
            table.insert(Ranked, {
                Score = Score,
                Key = Entry.Key,
                Answers = Entry.Answers,
            })
        end
    end

    table.sort(Ranked, function(A, B)
        if A.Score == B.Score then
            return #A.Key > #B.Key
        end
        return A.Score > B.Score
    end)

    local Results = {}
    local Seen = {}

    for _, Match in ipairs(Ranked) do
        for _, Answer in ipairs(Match.Answers) do
            local Id = Compact(Answer)
            if not Seen[Id] then
                Seen[Id] = true
                table.insert(Results, {
                    Answer = Answer,
                    Source = Match.Key,
                    Score = Match.Score,
                    Length = #Compact(Answer),
                })
            end
        end
    end

    table.sort(Results, function(A, B)
        if A.Score == B.Score then
            return A.Length > B.Length
        end
        return A.Score > B.Score
    end)

    return Results
end

local function SafeCopy(Text)
    Text = tostring(Text or "")

    if setclipboard then
        local Ok = pcall(function()
            setclipboard(Text)
        end)

        if Ok then
            return true
        end
    end

    return false
end

local function GetGuiParent()
    if type(gethui) == "function" then
        local Ok, Result = pcall(gethui)
        if Ok and Result then
            return Result
        end
    end

    local OkCoreGui, Result = pcall(function()
        return CoreGui
    end)

    if OkCoreGui and Result then
        return Result
    end

    return LocalPlayer:WaitForChild("PlayerGui")
end

local function IsObjVisible(Obj)
    local Current = Obj

    while Current and Current ~= game do
        if Current:IsA("GuiObject") and Current.Visible == false then
            return false
        end

        Current = Current.Parent
    end

    return true
end

local function LooksLikeQuestion(Text)
    Text = tostring(Text or "")
    local Clean = Normalize(Text)

    if #Clean < 4 or #Clean > 90 then
        return false
    end

    local Bad = {
        "search",
        "debug",
        "httpget",
        "runtime",
        "compile",
        "source length",
        "type or die helper",
        "answer suggestions",
        "copied",
        "no answer",
        "local ui",
    }

    for _, Word in ipairs(Bad) do
        if Clean:find(Word, 1, true) then
            return false
        end
    end

    local GoodWords = {
        "name",
        "type",
        "popular",
        "something",
        "character",
        "find",
        "object",
        "music",
        "word",
        "minecraft",
        "american",
        "position",
        "currency",
        "search engine",
        "house",
        "country",
        "breed",
        "state",
        "friendly",
        "topping",
        "flightless",
        "phobia",
        "dessert",
    }

    for _, Word in ipairs(GoodWords) do
        if Clean:find(Word, 1, true) then
            return true
        end
    end

    -- Most Type Or Die questions are shown in uppercase.
    local Letters = 0
    local Upper = 0

    for Char in Text:gmatch(".") do
        if Char:match("%a") then
            Letters = Letters + 1
            if Char:match("%u") then
                Upper = Upper + 1
            end
        end
    end

    return Letters >= 5 and Upper / math.max(Letters, 1) > 0.65
end

local function DetectQuestionFromScreen()
    local BestText = ""
    local BestScore = 0

    local Roots = {}

    local PlayerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if PlayerGui then
        table.insert(Roots, PlayerGui)
    end

    local OkCore, Core = pcall(function()
        return CoreGui
    end)

    if OkCore and Core then
        table.insert(Roots, Core)
    end

    for _, Root in ipairs(Roots) do
        for _, Obj in ipairs(Root:GetDescendants()) do
            if Obj:IsA("TextLabel") or Obj:IsA("TextButton") then
                if Obj:IsDescendantOf(script) then
                    continue
                end

                if Obj:FindFirstAncestor(GuiName) then
                    continue
                end

                if IsObjVisible(Obj) then
                    local Text = tostring(Obj.Text or "")
                    if LooksLikeQuestion(Text) then
                        local Clean = Normalize(Text)
                        local Score = #Clean

                        if Text == Text:upper() then
                            Score = Score + 30
                        end

                        if Obj.AbsolutePosition.Y < 250 then
                            Score = Score + 20
                        end

                        if Score > BestScore then
                            BestScore = Score
                            BestText = Text
                        end
                    end
                end
            end
        end
    end

    return BestText
end

