    if Hub.Config.AutoBonusBoss then Hub.Dungeon.voteBonusBoss(true) end
    if Hub.Config.Killaura then Hub.Combat.handleEnemy("DRY_RUN_ENEMY") end
    if Hub.Config.AutoSell then Hub.Inventory.autoSell({}) end
end

