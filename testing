local LogFile = "dq_clean_v16_log.jsonl"

local function typeOf(value)
    if typeof then
        local ok, result = pcall(typeof, value)
        if ok then return result end
    end
    return type(value)
end

local function escapeJson(s)
    s = tostring(s)
    return s:gsub("\\","\\\\"):gsub('"','\\"'):gsub("\n","\\n"):gsub("\r","\\r"):gsub("\t","\\t")
end

local function fallbackJson(value, depth, seen)
    depth = depth or 0
    seen = seen or {}
    if depth > 6 then return "\"<max_depth>\"" end
    local t = typeOf(value)
    if t == "nil" then return "null" end
    if t == "boolean" or t == "number" then return tostring(value) end
    if t == "string" then return "\"" .. escapeJson(value) .. "\"" end
    if t == "table" then
        if seen[value] then return "\"<cycle>\"" end
        seen[value] = true
        local isArray, maxIndex = true, 0
        for k in pairs(value) do
            if type(k) ~= "number" then isArray = false break end
            if k > maxIndex then maxIndex = k end
        end
        local parts = {}
        if isArray then
            for i = 1, maxIndex do
                table.insert(parts, fallbackJson(value[i], depth + 1, seen))
            end
            return "[" .. table.concat(parts, ",") .. "]"
        end
        for k, v in pairs(value) do
            table.insert(parts, fallbackJson(tostring(k), depth + 1, seen) .. ":" .. fallbackJson(v, depth + 1, seen))
        end
        return "{" .. table.concat(parts, ",") .. "}"
    end
    return "\"" .. escapeJson("<" .. tostring(t) .. ":" .. tostring(value) .. ">") .. "\""
end

local function encodeJson(value)
    local ok, http = pcall(function()
        return game:GetService("HttpService")
    end)
    if ok and http and http.JSONEncode then
        local ok2, encoded = pcall(function()
            return http:JSONEncode(value)
        end)
        if ok2 then return encoded end
    end
    return fallbackJson(value)
end

local function appendLog(line)
    if appendfile then
        local ok = pcall(function() appendfile(LogFile, line .. "\n") end)
        if ok then return true end
    end
    if writefile and readfile and isfile then
        local ok = pcall(function()
            local old = ""
            if isfile(LogFile) then old = readfile(LogFile) end
            writefile(LogFile, old .. line .. "\n")
        end)
        if ok then return true end
    end
    return false
end

function Hub.log(kind, data)
    local event = {
        version = Hub.Version,
        time = os and os.time and os.time() or 0,
        kind = tostring(kind),
        data = data or {},
    }
    table.insert(Hub.Runtime.Log, event)
    appendLog(encodeJson(event))
    print("[DQ Clean v16]", kind)
    return event
end

local function blocked(name, reason, data)
    return Hub.log("blocked", {
        name = tostring(name),
        reason = tostring(reason or "blocked by SecurityPolicy"),
        data = data or {},
    })
end

function Hub.resetLog()
    if writefile then
        pcall(function() writefile(LogFile, "") end)
    end
end

function Hub.assertSecurity()
    for key, expected in pairs({
        AllowOriginalVM = false,
        AllowKeySystem = false,
        AllowExternalHttp = false,
        AllowDiscordWebhook = false,
        AllowDashboardTelemetry = false,
        AllowQueueOnTeleport = false,
        AllowExternalUILoad = false,
        AllowGameRemotes = false,
        DryRun = true,
    }) do
        if Hub.SecurityPolicy[key] == expected then
            Hub.log("security_pass", { key = key, value = expected })
        else
            Hub.log("security_fail", { key = key, value = Hub.SecurityPolicy[key], expected = expected })
        end
    end
end

