--[[
MiniRayfield Local Shim

Goal:
- Replace the external Rayfield loadstring dependency.
- Keep the same basic Rayfield-style API used by the reconstructed Type Or Die script.
- Preserve a similar dark, rounded, tabbed look and notification feel.

How to use in your script:
1. Paste this whole file above your rebuilt Type Or Die logic.
2. Replace this old line:

   local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

   with this:

   local Rayfield = CreateLocalRayfield()

Supported API used by the rebuild:
- Rayfield:CreateWindow({...})
- Window:CreateTab(Name, Icon)
- Tab:CreateParagraph({Title = "...", Content = "..."})
- Tab:CreateInput({Name = "...", PlaceholderText = "...", RemoveTextAfterFocusLost = true, Callback = function(Text) end})
- Tab:CreateToggle({Name = "...", CurrentValue = false, Callback = function(Value) end})
- Rayfield:Notify({Title = "...", Content = "...", Duration = 5})
]]

local function CreateLocalRayfield()
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")

    local LocalPlayer = Players.LocalPlayer

    local Colors = {
        Background = Color3.fromRGB(21, 23, 31),
        Panel = Color3.fromRGB(29, 32, 43),
        Panel2 = Color3.fromRGB(35, 39, 52),
        Panel3 = Color3.fromRGB(43, 48, 64),
        Stroke = Color3.fromRGB(70, 78, 104),
        Accent = Color3.fromRGB(116, 128, 255),
        Accent2 = Color3.fromRGB(92, 199, 255),
        Text = Color3.fromRGB(238, 242, 255),
        Muted = Color3.fromRGB(170, 178, 204),
        DarkText = Color3.fromRGB(90, 96, 120),
        Success = Color3.fromRGB(75, 220, 140),
        Warning = Color3.fromRGB(255, 205, 100),
    }

    local Font = Enum.Font.Gotham
    local BoldFont = Enum.Font.GothamBold
    local SemiboldFont = Enum.Font.GothamSemibold

    local Rayfield = {}
    Rayfield.Flags = {}

    local function GetGuiParent()
        if type(gethui) == "function" then
            local Ok, Result = pcall(gethui)
            if Ok and Result then
                return Result
            end
        end

        local OkCoreGui, CoreGui = pcall(function()
            return game:GetService("CoreGui")
        end)

        if OkCoreGui and CoreGui then
            return CoreGui
        end

        return LocalPlayer:WaitForChild("PlayerGui")
    end

    local function Create(ClassName, Properties, Children)
        local Object = Instance.new(ClassName)

        for Key, Value in pairs(Properties or {}) do
            Object[Key] = Value
        end

        for _, Child in ipairs(Children or {}) do
            Child.Parent = Object
        end

        return Object
    end

    local function Corner(Radius)
        return Create("UICorner", {
            CornerRadius = UDim.new(0, Radius or 10),
        })
    end

    local function Stroke(Color, Thickness, Transparency)
        return Create("UIStroke", {
            Color = Color or Colors.Stroke,
            Thickness = Thickness or 1,
            Transparency = Transparency or 0.25,
        })
    end

    local function Padding(Left, Top, Right, Bottom)
        return Create("UIPadding", {
            PaddingLeft = UDim.new(0, Left or 0),
            PaddingTop = UDim.new(0, Top or 0),
            PaddingRight = UDim.new(0, Right or 0),
            PaddingBottom = UDim.new(0, Bottom or 0),
        })
    end

    local function ListLayout(PaddingPixels)
        return Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, PaddingPixels or 8),
        })
    end

    local function Tween(Object, Time, Properties)
        local Info = TweenInfo.new(Time or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local Anim = TweenService:Create(Object, Info, Properties)
        Anim:Play()
        return Anim
    end

    local function MakeDraggable(Handle, Target)
        local Dragging = false
        local DragStart = nil
        local StartPosition = nil

        Handle.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                Dragging = true
                DragStart = Input.Position
                StartPosition = Target.Position

                Input.Changed:Connect(function()
                    if Input.UserInputState == Enum.UserInputState.End then
                        Dragging = false
                    end
                end)
            end
        end)

        UserInputService.InputChanged:Connect(function(Input)
            if not Dragging then
                return
            end

            if Input.UserInputType ~= Enum.UserInputType.MouseMovement and Input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            local Delta = Input.Position - DragStart
            Target.Position = UDim2.new(
                StartPosition.X.Scale,
                StartPosition.X.Offset + Delta.X,
                StartPosition.Y.Scale,
                StartPosition.Y.Offset + Delta.Y
            )
        end)
    end

    local ScreenGui = Create("ScreenGui", {
        Name = "MiniRayfieldLocal",
        IgnoreGuiInset = true,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = GetGuiParent(),
    })

    local Existing = ScreenGui.Parent:FindFirstChild("MiniRayfieldLocal")
    if Existing and Existing ~= ScreenGui then
        Existing:Destroy()
    end

    local NotificationHolder = Create("Frame", {
        Name = "Notifications",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -18, 0, 18),
        Size = UDim2.new(0, 360, 1, -36),
        BackgroundTransparency = 1,
        Parent = ScreenGui,
    }, {
        ListLayout(10),
    })

    NotificationHolder.UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    NotificationHolder.UIListLayout.VerticalAlignment = Enum.VerticalAlignment.Top

    function Rayfield:Notify(Config)
        Config = Config or {}

        local Duration = tonumber(Config.Duration) or 5
        local Title = tostring(Config.Title or "Notification")
        local Content = tostring(Config.Content or "")

        local Card = Create("Frame", {
            Name = "Notification",
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = Colors.Panel,
            BackgroundTransparency = 0.03,
            ClipsDescendants = true,
            Parent = NotificationHolder,
        }, {
            Corner(13),
            Stroke(Colors.Stroke, 1, 0.1),
            Padding(14, 12, 14, 12),
        })

        local Bar = Create("Frame", {
            Name = "AccentBar",
            Position = UDim2.new(0, 0, 0, 0),
            Size = UDim2.new(0, 4, 1, 0),
            BackgroundColor3 = Colors.Accent,
            BorderSizePixel = 0,
            Parent = Card,
        }, {
            Corner(13),
        })

        local Body = Create("Frame", {
            Name = "Body",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -8, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Position = UDim2.new(0, 8, 0, 0),
            Parent = Card,
        }, {
            ListLayout(4),
        })

        Create("TextLabel", {
            Name = "Title",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 20),
            Font = SemiboldFont,
            Text = Title,
            TextColor3 = Colors.Text,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            TextWrapped = true,
            Parent = Body,
        })

        Create("TextLabel", {
            Name = "Content",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = Font,
            Text = Content,
            TextColor3 = Colors.Muted,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            Parent = Body,
        })

        Card.Position = UDim2.new(0, 420, 0, 0)
        Tween(Card, 0.22, { Position = UDim2.new(0, 0, 0, 0) })

        task.delay(Duration, function()
            if Card and Card.Parent then
                Tween(Card, 0.18, {
                    Position = UDim2.new(0, 420, 0, 0),
                    BackgroundTransparency = 1,
                })
                task.wait(0.2)
                if Card and Card.Parent then
                    Card:Destroy()
                end
            end
        end)
    end

    function Rayfield:CreateWindow(Config)
        Config = Config or {}

        local Window = {}
        Window.Tabs = {}
        Window.CurrentTab = nil

        local Main = Create("Frame", {
            Name = "Window",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0, 760, 0, 500),
            BackgroundColor3 = Colors.Background,
            ClipsDescendants = true,
            Parent = ScreenGui,
        }, {
            Corner(16),
            Stroke(Colors.Stroke, 1, 0.08),
        })

        local Topbar = Create("Frame", {
            Name = "Topbar",
            Size = UDim2.new(1, 0, 0, 58),
            BackgroundColor3 = Colors.Panel,
            BorderSizePixel = 0,
            Parent = Main,
        })

        local TitleLabel = Create("TextLabel", {
            Name = "Title",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 18, 0, 8),
            Size = UDim2.new(1, -112, 0, 24),
            Font = BoldFont,
            Text = tostring(Config.Name or "Window"),
            TextColor3 = Colors.Text,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = Topbar,
        })

        Create("TextLabel", {
            Name = "Subtitle",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 18, 0, 31),
            Size = UDim2.new(1, -112, 0, 18),
            Font = Font,
            Text = tostring(Config.LoadingSubtitle or "Local UI"),
            TextColor3 = Colors.Muted,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = Topbar,
        })

        local MinimizeButton = Create("TextButton", {
            Name = "Minimize",
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -54, 0, 14),
            Size = UDim2.new(0, 30, 0, 30),
            AutoButtonColor = false,
            BackgroundColor3 = Colors.Panel2,
            Font = BoldFont,
            Text = "–",
            TextColor3 = Colors.Text,
            TextSize = 18,
            Parent = Topbar,
        }, {
            Corner(8),
            Stroke(Colors.Stroke, 1, 0.35),
        })

        local CloseButton = Create("TextButton", {
            Name = "Close",
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -18, 0, 14),
            Size = UDim2.new(0, 30, 0, 30),
            AutoButtonColor = false,
            BackgroundColor3 = Colors.Panel2,
            Font = BoldFont,
            Text = "×",
            TextColor3 = Colors.Text,
            TextSize = 18,
            Parent = Topbar,
        }, {
            Corner(8),
            Stroke(Colors.Stroke, 1, 0.35),
        })

        local Sidebar = Create("Frame", {
            Name = "Sidebar",
            Position = UDim2.new(0, 0, 0, 58),
            Size = UDim2.new(0, 190, 1, -58),
            BackgroundColor3 = Colors.Panel,
            BorderSizePixel = 0,
            Parent = Main,
        }, {
            Padding(12, 12, 12, 12),
            ListLayout(8),
        })

        local Content = Create("Frame", {
            Name = "Content",
            Position = UDim2.new(0, 190, 0, 58),
            Size = UDim2.new(1, -190, 1, -58),
            BackgroundColor3 = Colors.Background,
            BorderSizePixel = 0,
            Parent = Main,
        }, {
            Padding(14, 14, 14, 14),
        })

        MakeDraggable(Topbar, Main)

        local IsMinimized = false

        MinimizeButton.MouseButton1Click:Connect(function()
            IsMinimized = not IsMinimized
            Sidebar.Visible = not IsMinimized
            Content.Visible = not IsMinimized
            Tween(Main, 0.2, {
                Size = IsMinimized and UDim2.new(0, 760, 0, 58) or UDim2.new(0, 760, 0, 500),
            })
            MinimizeButton.Text = IsMinimized and "+" or "–"
        end)

        CloseButton.MouseButton1Click:Connect(function()
            ScreenGui:Destroy()
        end)

        function Window:CreateTab(TabName, Icon)
            local Tab = {}
            Tab.Name = tostring(TabName or "Tab")

            local TabButton = Create("TextButton", {
                Name = "TabButton",
                Size = UDim2.new(1, 0, 0, 38),
                AutoButtonColor = false,
                BackgroundColor3 = Colors.Panel2,
                Font = SemiboldFont,
                Text = Tab.Name,
                TextColor3 = Colors.Muted,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = Sidebar,
            }, {
                Corner(10),
                Stroke(Colors.Stroke, 1, 0.55),
                Padding(12, 0, 12, 0),
            })

            local TabPage = Create("ScrollingFrame", {
                Name = Tab.Name,
                Size = UDim2.new(1, 0, 1, 0),
                CanvasSize = UDim2.new(0, 0, 0, 0),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ScrollBarThickness = 4,
                ScrollBarImageColor3 = Colors.Accent,
                Visible = false,
                Parent = Content,
            }, {
                Padding(2, 2, 8, 12),
                ListLayout(10),
            })

            local function SelectTab()
                for _, Other in ipairs(Window.Tabs) do
                    Other.Page.Visible = false
                    Tween(Other.Button, 0.12, {
                        BackgroundColor3 = Colors.Panel2,
                        TextColor3 = Colors.Muted,
                    })
                end

                TabPage.Visible = true
                Tween(TabButton, 0.12, {
                    BackgroundColor3 = Colors.Accent,
                    TextColor3 = Colors.Text,
                })
                Window.CurrentTab = Tab
            end

            TabButton.MouseButton1Click:Connect(SelectTab)

            local function CreateCard(Height)
                return Create("Frame", {
                    Size = UDim2.new(1, 0, 0, Height or 68),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = Colors.Panel,
                    Parent = TabPage,
                }, {
                    Corner(12),
                    Stroke(Colors.Stroke, 1, 0.42),
                    Padding(14, 12, 14, 12),
                })
            end

            function Tab:CreateParagraph(Config)
                Config = Config or {}

                local Card = CreateCard(70)
                local Stack = Create("Frame", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Parent = Card,
                }, {
                    ListLayout(4),
                })

                Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 19),
                    Font = SemiboldFont,
                    Text = tostring(Config.Title or "Paragraph"),
                    TextColor3 = Colors.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    Parent = Stack,
                })

                Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Font = Font,
                    Text = tostring(Config.Content or ""),
                    TextColor3 = Colors.Muted,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    Parent = Stack,
                })

                return Card
            end

            function Tab:CreateInput(Config)
                Config = Config or {}

                local Card = CreateCard(92)
                local NameLabel = Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, 0),
                    Size = UDim2.new(1, 0, 0, 20),
                    Font = SemiboldFont,
                    Text = tostring(Config.Name or "Input"),
                    TextColor3 = Colors.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Card,
                })

                local Box = Create("TextBox", {
                    BackgroundColor3 = Colors.Panel2,
                    Position = UDim2.new(0, 0, 0, 34),
                    Size = UDim2.new(1, 0, 0, 38),
                    ClearTextOnFocus = false,
                    Font = Font,
                    PlaceholderText = tostring(Config.PlaceholderText or "Type here..."),
                    PlaceholderColor3 = Colors.DarkText,
                    Text = "",
                    TextColor3 = Colors.Text,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Card,
                }, {
                    Corner(10),
                    Stroke(Colors.Stroke, 1, 0.45),
                    Padding(12, 0, 12, 0),
                })

                Box.Focused:Connect(function()
                    Tween(Box, 0.12, { BackgroundColor3 = Colors.Panel3 })
                end)

                Box.FocusLost:Connect(function(EnterPressed)
                    Tween(Box, 0.12, { BackgroundColor3 = Colors.Panel2 })

                    if EnterPressed then
                        local Text = Box.Text

                        if type(Config.Callback) == "function" then
                            task.spawn(Config.Callback, Text)
                        end

                        if Config.RemoveTextAfterFocusLost then
                            Box.Text = ""
                        end
                    end
                end)

                return Box
            end

            function Tab:CreateToggle(Config)
                Config = Config or {}

                local Value = Config.CurrentValue == true
                local Card = CreateCard(58)

                local Label = Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, 0),
                    Size = UDim2.new(1, -76, 0, 34),
                    Font = SemiboldFont,
                    Text = tostring(Config.Name or "Toggle"),
                    TextColor3 = Colors.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Center,
                    Parent = Card,
                })

                local Switch = Create("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.new(0, 56, 0, 30),
                    AutoButtonColor = false,
                    BackgroundColor3 = Value and Colors.Accent or Colors.Panel2,
                    Text = "",
                    Parent = Card,
                }, {
                    Corner(999),
                    Stroke(Colors.Stroke, 1, 0.45),
                })

                local Knob = Create("Frame", {
                    Position = Value and UDim2.new(1, -27, 0.5, -11) or UDim2.new(0, 5, 0.5, -11),
                    Size = UDim2.new(0, 22, 0, 22),
                    BackgroundColor3 = Colors.Text,
                    Parent = Switch,
                }, {
                    Corner(999),
                })

                local function Set(NewValue, FireCallback)
                    Value = NewValue == true

                    Tween(Switch, 0.15, {
                        BackgroundColor3 = Value and Colors.Accent or Colors.Panel2,
                    })

                    Tween(Knob, 0.15, {
                        Position = Value and UDim2.new(1, -27, 0.5, -11) or UDim2.new(0, 5, 0.5, -11),
                    })

                    if FireCallback and type(Config.Callback) == "function" then
                        task.spawn(Config.Callback, Value)
                    end
                end

                Switch.MouseButton1Click:Connect(function()
                    Set(not Value, true)
                end)

                Card.InputBegan:Connect(function(Input)
                    if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                        Set(not Value, true)
                    end
                end)

                local ToggleObject = {}

                function ToggleObject:Set(NewValue)
                    Set(NewValue, true)
                end

                function ToggleObject:Get()
                    return Value
                end

                return ToggleObject
            end

            Tab.Button = TabButton
            Tab.Page = TabPage
            table.insert(Window.Tabs, Tab)

            if not Window.CurrentTab then
                SelectTab()
            end

            return Tab
        end

        if Config.LoadingTitle then
            Rayfield:Notify({
                Title = tostring(Config.LoadingTitle),
                Content = tostring(Config.LoadingSubtitle or ""),
                Duration = 2,
            })
        end

        return Window
    end

    return Rayfield
end
