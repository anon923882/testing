function Hub.assertSecurity()
    for key, expected in pairs({
        AllowOriginalVM=false, AllowKeySystem=false, AllowExternalHttp=false,
        AllowDiscordWebhook=false, AllowDashboardTelemetry=false, AllowQueueOnTeleport=false,
        AllowExternalUILoad=false, AllowGameRemotes=false, DryRun=true,
    }) do
        if Hub.SecurityPolicy[key] == expected then
            Hub.log("security_pass", {key=key, value=expected})
        else
            Hub.log("security_fail", {key=key, expected=expected, actual=Hub.SecurityPolicy[key]})
        end
    end
end

