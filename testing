local function AddAnswerButton(Index, Result)
    local Answer = Result.Answer
    local Source = Result.Source
    local Length = Result.Length

    local Button = Create("TextButton", {
        Name = "Answer_" .. tostring(Index),
        Size = UDim2.new(1, 0, 0, 44),
        AutoButtonColor = false,
        BackgroundColor3 = Colors.Panel2,
        Font = SemiboldFont,
        Text = string.format("%02d. %s  (%d)", Index, Answer, Length),
        TextColor3 = Colors.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = ResultsHolder,
    }, {
        Corner(10),
        Stroke(Colors.Stroke, 1, 0.45),
        Padding(12, 0, 12, 0),
    })

    Button.MouseEnter:Connect(function()
        Tween(Button, 0.1, {
            BackgroundColor3 = Colors.Panel3,
        })
    end)

    Button.MouseLeave:Connect(function()
        Tween(Button, 0.1, {
            BackgroundColor3 = Colors.Panel2,
        })
    end)

    Button.MouseButton1Click:Connect(function()
        LastBestAnswer = Answer
        local Copied = SafeCopy(Answer)

        if Copied then
            SetStatus("Copied: " .. Answer, true)
        else
            SetStatus("Selected: " .. Answer .. " | Clipboard unsupported, copy manually.", false)
        end
    end)

    local Sub = Create("TextLabel", {
        Name = "Source",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 25),
        Size = UDim2.new(1, -24, 0, 16),
        Font = Font,
        Text = "matched: " .. tostring(Source),
        TextColor3 = Colors.Muted,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Button,
    })

    return Button
end

local function RenderAnswers(Query)
    Query = tostring(Query or "")
    LastDetectedQuestion = Query

    ClearResults()

    if QuestionBox and QuestionBox.Text ~= Query then
        QuestionBox.Text = Query
    end

    if Normalize(Query) == "" then
        LastBestAnswer = ""
        SetStatus("Enter or detect a question.", false)
        return
    end

    local Answers = FindAnswers(Query)

    if #Answers == 0 then
        LastBestAnswer = ""
        SetStatus("No local match for: " .. Query, false)

        local Empty = Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 50),
            BackgroundColor3 = Colors.Panel2,
            Font = Font,
            Text = "No match yet. Add this question to the AnswerDB table.",
            TextColor3 = Colors.Muted,
            TextSize = 13,
            TextWrapped = true,
            Parent = ResultsHolder,
        }, {
            Corner(10),
            Stroke(Colors.Stroke, 1, 0.45),
            Padding(12, 0, 12, 0),
        })

        return
    end

    LastBestAnswer = Answers[1].Answer

    for Index, Result in ipairs(Answers) do
        if Index > 12 then
            break
        end

        AddAnswerButton(Index, Result)
    end

    SetStatus("Best: " .. LastBestAnswer .. " | Matches: " .. tostring(#Answers), true)
end

local function DetectAndRender()
    local Question = DetectQuestionFromScreen()

    if Question and Question ~= "" then
        RenderAnswers(Question)
    else
        SetStatus("Could not detect a question on screen.", false)
    end
end

