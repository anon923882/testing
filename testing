--[[
DQ Delta Executor Dry-Run Dump Script
Version: v15-delta-dump

Run this in Delta when you get the chance.

This script:
- does NOT run the original obfuscated DQ script
- does NOT load external URLs
- does NOT send Discord webhooks
- does NOT call the Vercel/dashboard API
- does NOT queue anything on teleport
- does NOT FireServer/InvokeServer any game remotes
- creates local dump/log files for us to review

Expected files:
- dq_delta_dump.jsonl
- dq_delta_summary.txt

If files do not appear, copy the console output or clipboard fallback.
]]

local VERSION = "v15-delta-dump"
local JsonLogFile = "dq_delta_dump.jsonl"
local SummaryFile = "dq_delta_summary.txt"

local SecurityPolicy = {
    AllowOriginalVM = false,
    AllowKeySystem = false,
    AllowExternalHttp = false,
    AllowDiscordWebhook = false,
    AllowDashboardTelemetry = false,
    AllowQueueOnTeleport = false,
    AllowExternalUILoad = false,
    AllowGameRemotes = false,
    DryRun = true,
}

local Events = {}

local function getType(v)
    if typeof then
        local ok, result = pcall(typeof, v)
        if ok then return result end
    end
    return type(v)
end

local function jsonEscape(s)
    s = tostring(s)
    s = s:gsub("\\", "\\\\")
         :gsub('"', '\\"')
         :gsub("\n", "\\n")
         :gsub("\r", "\\r")
         :gsub("\t", "\\t")
    return s
end

local function fallbackJson(v, depth, seen)
    depth = depth or 0
    seen = seen or {}
    if depth > 5 then return '"<max_depth>"' end
    local t = getType(v)
    if t == "nil" then return "null" end
    if t == "number" or t == "boolean" then return tostring(v) end
    if t == "string" then return '"' .. jsonEscape(v) .. '"' end
    if t == "table" then
        if seen[v] then return '"<cycle>"' end
        seen[v] = true
        local parts = {}
        local isArray = true
        local maxIndex = 0
        for k in pairs(v) do
            if type(k) ~= "number" then isArray = false break end
            if k > maxIndex then maxIndex = k end
        end
        if isArray then
            for i = 1, maxIndex do
                table.insert(parts, fallbackJson(v[i], depth + 1, seen))
            end
            return "[" .. table.concat(parts, ",") .. "]"
        end
        for k, val in pairs(v) do
            table.insert(parts, fallbackJson(tostring(k), depth + 1, seen) .. ":" .. fallbackJson(val, depth + 1, seen))
        end
        return "{" .. table.concat(parts, ",") .. "}"
    end
    return '"' .. jsonEscape("<" .. tostring(t) .. ":" .. tostring(v) .. ">") .. '"'
end

local function encodeJson(v)
    local ok, http = pcall(function()
        return game and game:GetService("HttpService")
    end)
    if ok and http and http.JSONEncode then
        local ok2, encoded = pcall(function()
            return http:JSONEncode(v)
        end)
        if ok2 then return encoded end
    end
    return fallbackJson(v)
end

local function canCallGlobal(name)
    local ok, value = pcall(function()
        return getgenv and getgenv()[name] or _G[name]
    end)
    return ok and value ~= nil, value
end

local function appendLine(path, line)
    if appendfile then
        local ok = pcall(function()
            appendfile(path, line .. "\n")
        end)
        if ok then return true end
    end

    if writefile and readfile and isfile then
        local ok = pcall(function()
            local old = ""
            if isfile(path) then old = readfile(path) end
            writefile(path, old .. line .. "\n")
        end)
        if ok then return true end
    end

    return false
end

local function writeText(path, text)
    if writefile then
        local ok = pcall(function()
            writefile(path, text)
        end)
        return ok
    end
    return false
end

local function event(kind, data)
    local item = {
        version = VERSION,
        time = os and os.time and os.time() or 0,
        kind = tostring(kind),
        data = data or {},
    }

    table.insert(Events, item)

    local line = encodeJson(item)
    appendLine(JsonLogFile, line)
    print("[DQ Delta Dump]", kind, line)
    return item
end

local function blocked(name, reason, data)
    return event("blocked", {
        name = tostring(name),
        reason = reason or "blocked by dry-run policy",
        data = data or {},
    })
end

local function functionExists(name)
    local ok, value = canCallGlobal(name)
    return ok, getType(value)
end

local function safeService(name)
    local ok, service = pcall(function()
        return game:GetService(name)
    end)
    if ok and service then
        event("service_available", { name = name, className = service.ClassName })
        return service
    end
    event("service_unavailable", { name = name })
    return nil
end

local function detectExecutor()
    local names = {
        "identifyexecutor",
        "getexecutorname",
    }

    for _, fnName in ipairs(names) do
        local exists, fn = canCallGlobal(fnName)
        if exists and type(fn) == "function" then
            local ok, a, b = pcall(fn)
            event("executor_identity", {
                functionName = fnName,
                ok = ok,
                value1 = tostring(a),
                value2 = tostring(b),
            })
            return
        end
    end

    event("executor_identity", {
        ok = false,
        value1 = "unknown",
    })
end

local function capabilityDump()
    local globals = {
        "writefile", "readfile", "appendfile", "isfile", "isfolder", "makefolder", "listfiles",
        "getgenv", "getsenv", "getrenv", "getgc", "hookfunction", "hookmetamethod",
        "setreadonly", "isreadonly", "checkcaller",
        "request", "http_request", "syn", "queue_on_teleport", "setclipboard",
        "loadstring",
    }

    for _, name in ipairs(globals) do
        local exists, t = functionExists(name)
        event("capability", {
            name = name,
            exists = exists,
            valueType = t,
            note = "existence check only; not called unless harmless",
        })
    end
end

local function fileSystemTest()
    local canWrite = writeText(JsonLogFile, "")
    event("filesystem_test", {
        writefile = writefile ~= nil,
        appendfile = appendfile ~= nil,
        readfile = readfile ~= nil,
        isfile = isfile ~= nil,
        canWriteLog = canWrite,
        jsonLogFile = JsonLogFile,
        summaryFile = SummaryFile,
    })

    if writefile then
        local ok = pcall(function()
            writefile("dq_delta_fs_test.txt", "ok")
        end)
        event("filesystem_write_test", { ok = ok, path = "dq_delta_fs_test.txt" })
    end
end

local Network = {}

function Network.request(payload)
    return blocked("request", "external HTTP disabled; not sent", payload)
end

function Network.httpGet(url)
    return blocked("HttpGet", "external loader disabled; not fetched", { url = url })
end

function Network.discordWebhook(payload)
    return blocked("discord_webhook", "Discord webhook disabled; not sent", payload)
end

function Network.dashboard(payload)
    return blocked("dashboard_telemetry", "Vercel/dashboard telemetry removed; not sent", payload)
end

function Network.queueOnTeleport(code)
    return blocked("queue_on_teleport", "teleport persistence disabled; not queued", {
        preview = tostring(code):sub(1, 180)
    })
end

local Remotes = {}

local function remoteStub(name, ...)
    local args = { ... }
    return event("remote_stub", {
        name = tostring(name),
        argc = #args,
        args = args,
        fired = false,
        reason = "AllowGameRemotes=false; no FireServer/InvokeServer called",
    })
end

function Remotes.vote(...) return remoteStub("vote", ...) end
function Remotes.PlaySolo(...) return remoteStub("PlaySolo", ...) end
function Remotes.ReturnToLobby(...) return remoteStub("ReturnToLobby", ...) end
function Remotes.RetryVote(...) return remoteStub("RetryVote", ...) end
function Remotes.changeStartValue(...) return remoteStub("changeStartValue", ...) end
function Remotes.CreateParty(...) return remoteStub("CreateParty", ...) end
function Remotes.GetPlayerParty(...) return remoteStub("GetPlayerParty", ...) end
function Remotes.HandleJoinRequest(...) return remoteStub("HandleJoinRequest", ...) end
function Remotes.KickMember(...) return remoteStub("KickMember", ...) end
function Remotes.StartParty(...) return remoteStub("StartParty", ...) end
function Remotes.JoinParty(...) return remoteStub("JoinParty", ...) end
function Remotes.reloadInvy(...) return remoteStub("reloadInvy", ...) end
function Remotes.sellItemEvent(...) return remoteStub("sellItemEvent", ...) end
function Remotes.HandleEnemy(...) return remoteStub("HandleEnemy", ...) end
function Remotes.WeaponAttack(...) return remoteStub("Weapon.Attack", ...) end
function Remotes.spellEvent(...) return remoteStub("spellEvent", ...) end
function Remotes.abilityEvent(...) return remoteStub("abilityEvent", ...) end
function Remotes.localEvent(...) return remoteStub("localEvent", ...) end

local function createSmallGui()
    local ok, err = pcall(function()
        local players = game:GetService("Players")
        local player = players.LocalPlayer
        local parent = player and player:FindFirstChildOfClass("PlayerGui")
        if not parent then return end

        local old = parent:FindFirstChild("DQDeltaDump")
        if old then old:Destroy() end

        local gui = Instance.new("ScreenGui")
        gui.Name = "DQDeltaDump"
        gui.ResetOnSpawn = false
        gui.Parent = parent

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, 460, 0, 170)
        frame.Position = UDim2.new(0, 20, 0, 120)
        frame.BackgroundColor3 = Color3.fromRGB(22, 24, 32)
        frame.BorderSizePixel = 0
        frame.Parent = gui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 12)
        corner.Parent = frame

        local text = Instance.new("TextLabel")
        text.BackgroundTransparency = 1
        text.Position = UDim2.new(0, 14, 0, 12)
        text.Size = UDim2.new(1, -28, 1, -24)
        text.TextXAlignment = Enum.TextXAlignment.Left
        text.TextYAlignment = Enum.TextYAlignment.Top
        text.TextWrapped = true
        text.Font = Enum.Font.Gotham
        text.TextSize = 13
        text.TextColor3 = Color3.fromRGB(230, 235, 255)
        text.Text = "DQ Delta dry-run dump complete or running.\nNo original VM executed.\nNo HTTP/webhooks/remotes fired.\nUpload dq_delta_dump.jsonl and dq_delta_summary.txt."
        text.Parent = frame
    end)

    event("local_gui", {
        ok = ok,
        error = tostring(err),
    })
end

local function policyDump()
    for k, v in pairs(SecurityPolicy) do
        event("security_policy", {
            key = k,
            value = v,
        })
    end
end

local function dryRunFeatureFlow()
    -- Proves the clean behavior paths are log-only.
    Network.httpGet("https://sirius.menu/rayfield")
    Network.request({ Url = "https://nihility-dashboard-wqvy.vercel.app/api/update-account", Method = "POST" })
    Network.discordWebhook({ title = "Ultimate Drop", note = "not sent" })
    Network.dashboard({ username = "DRY_RUN", level = 0 })
    Network.queueOnTeleport("loadstring(game:HttpGet('external'))()")

    Remotes.PlaySolo("DRY_RUN_DUNGEON", "DRY_RUN_DIFFICULTY")
    Remotes.vote("BonusBoss", true)
    Remotes.RetryVote(true)
    Remotes.CreateParty({ visibility = "Private", mode = "Carry" })
    Remotes.HandleJoinRequest("DRY_RUN_PLAYER", true)
    Remotes.KickMember("DRY_RUN_PLAYER")
    Remotes.reloadInvy()
    Remotes.sellItemEvent("DRY_RUN_ITEM")
    Remotes.HandleEnemy("DRY_RUN_ENEMY")
    Remotes.WeaponAttack("DRY_RUN_ENEMY")
    Remotes.spellEvent("DRY_RUN_SKILL", "DRY_RUN_ENEMY")
    Remotes.abilityEvent("DRY_RUN_ABILITY", "DRY_RUN_ENEMY")
    Remotes.localEvent("skill", "DRY_RUN_SLOT", "DRY_RUN_ENEMY")
end

local function writeSummary()
    local lines = {}
    table.insert(lines, "DQ Delta Dump Summary")
    table.insert(lines, "Version: " .. VERSION)
    table.insert(lines, "Events: " .. tostring(#Events))
    table.insert(lines, "Security:")
    for k, v in pairs(SecurityPolicy) do
        table.insert(lines, "- " .. tostring(k) .. " = " .. tostring(v))
    end
    table.insert(lines, "")
    table.insert(lines, "Expected upload files:")
    table.insert(lines, "- " .. JsonLogFile)
    table.insert(lines, "- " .. SummaryFile)
    table.insert(lines, "")
    table.insert(lines, "This dump did not execute the original obfuscated DQ script.")
    table.insert(lines, "This dump did not fire game remotes or send HTTP/webhooks.")

    local summary = table.concat(lines, "\n")
    local wrote = writeText(SummaryFile, summary)

    if not wrote and setclipboard then
        pcall(function()
            setclipboard(summary)
        end)
        event("summary_clipboard_fallback", { used = true })
    end

    event("summary_written", {
        path = SummaryFile,
        wroteFile = wrote,
    })
end

local function main()
    fileSystemTest()
    event("start", {
        version = VERSION,
        placeId = game and game.PlaceId or nil,
        gameId = game and game.GameId or nil,
        jobId = game and game.JobId or nil,
    })

    detectExecutor()
    policyDump()
    capabilityDump()

    safeService("Players")
    safeService("ReplicatedStorage")
    safeService("Workspace")
    safeService("HttpService")
    safeService("TeleportService")

    dryRunFeatureFlow()
    createSmallGui()
    writeSummary()

    event("complete", {
        jsonLogFile = JsonLogFile,
        summaryFile = SummaryFile,
        totalEvents = #Events,
    })

    print("[DQ Delta Dump] Done. Upload dq_delta_dump.jsonl and dq_delta_summary.txt")
end

main()

return {
    SecurityPolicy = SecurityPolicy,
    Events = Events,
}
